    {
      "id": "sec-1792846212748-usadztn84",
      "type": "textMediaGrid",
      "variant": "media-right",
      "order": 2,
      "enabled": true,
      "content": {
        "eyebrow": "Infrastructure Alignment",
        "eyebrowIcon": "City",
        "heading": "Powering Regional",
        "headingHighlight": "Vision 2030",
        "headingAfter": "Corporate Ecosystem.",
        "description": "<p class=\"mb-6 leading-relaxed\">As the Kingdom and GCC region undergo unprecedented economic diversification under the <strong>Vision 2030</strong> mandate, executive mobility infrastructure has evolved exponentially. AB operates at the nexus of this transformation, providing highly secure, scalable, and meticulously managed mobility solutions for multinational corporations entering the market.</p><p class=\"mb-6 leading-relaxed\">Our strategic dispatch capabilities are engineered specifically for premier economic corridors. We maintain a continuous, vetted presence within the <strong>King Abdullah Financial District (KAFD)</strong> and the <strong>Diplomatic Quarter (DQ)</strong>, navigating rigorous security protocols with absolute discretion and efficiency.</p><p class=\"leading-relaxed\">Beyond standard transfers, our <em>Retail & Commercial Mobility Solutions</em> services provide global executives with the fluid, reliable mobility required to execute complex operations across the GCC's expanding urban and industrial footprint.</p>",
        "items": [
          {
            "id": "itm-1792846212748-pf3d91x28",
            "icon": "BuildingShield",
            "heading": "KAFD & Business Hubs",
            "description": "Dedicated fleet positioning for immediate financial district deployments."
          },
          {
            "id": "itm-1792846212748-gjoqyde16",
            "icon": "Passport",
            "heading": "Diplomatic Protocol",
            "description": "Vetted personnel trained in embassy and diplomatic security standards."
